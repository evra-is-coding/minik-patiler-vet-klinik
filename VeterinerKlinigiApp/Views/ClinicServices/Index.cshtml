@model IEnumerable<VeterinerKlinigiApp.Models.ClinicService>

@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Hizmetler</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Hizmet Ekle</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.ClinicId)</th>
                <th>@Html.DisplayNameFor(model => model.DurationMinutes)</th>
                <th>@Html.DisplayNameFor(model => model.Price)</th>
                <th style="width: 210px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Clinic?.Name ?? "-")</td>
                    <td>@item.DurationMinutes dk</td>
                    <td>@item.Price.ToString("N2") ₺</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detay</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>   