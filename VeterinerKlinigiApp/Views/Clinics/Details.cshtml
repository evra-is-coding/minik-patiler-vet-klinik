@model VeterinerKlinigiApp.Models.Clinic

@{
    ViewData["Title"] = "Klinik Detayı";
}

<h2 class="mb-3">Klinik Detayı</h2>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Address)</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone)</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OpeningTime)</dt>
            <dd class="col-sm-9">@Model.OpeningTime.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ClosingTime)</dt>
            <dd class="col-sm-9">@Model.ClosingTime.ToString(@"hh\:mm")</dd>
        </dl>
    </div>
</div>

<h4 class="mb-2">Sunulan Hizmetler</h4>
@if (Model.Services != null && Model.Services.Any())
{
    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>Hizmet Adı</th>
                <th>Süre (Dakika)</th>
                <th>Ücret (₺)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Services)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.DurationMinutes</td>
                    <td>@s.Price.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Bu kliniğe ait kayıtlı hizmet bulunmuyor.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
<a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>  