@model VeterinerKlinigiApp.Models.VeterinarianAvailability

@{
    ViewData["Title"] = "Müsaitlik Sil";
}

<h2 class="mb-3 text-danger">Müsaitlik Sil</h2>
<p>Bu müsaitlik kaydını silmek istediğinize emin misiniz?</p>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Veteriner Hekim</dt>
            <dd class="col-sm-9">@(Model.Veterinarian?.FullName ?? "-")</dd>

            <dt class="col-sm-3">Başlangıç</dt>
            <dd class="col-sm-9">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Bitiş</dt>
            <dd class="col-sm-9">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>
