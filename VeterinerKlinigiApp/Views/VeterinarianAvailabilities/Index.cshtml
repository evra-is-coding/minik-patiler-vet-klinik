@model IEnumerable<VeterinerKlinigiApp.Models.VeterinarianAvailability>

@{
    ViewData["Title"] = "Hekim Müsaitlik Saatleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Hekim Müsaitlik Saatleri</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Müsaitlik Ekle</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Veteriner Hekim</th>
                <th>Klinik</th>
                <th>Başlangıç</th>
                <th>Bitiş</th>
                <th style="width: 150px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Veterinarian?.FullName ?? "-")</td>
                    <td>@(item.Veterinarian?.Clinic?.Name ?? "-")</td>
                    <td>@item.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>  
