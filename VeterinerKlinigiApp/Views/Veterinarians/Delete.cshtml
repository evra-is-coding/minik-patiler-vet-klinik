@model VeterinerKlinigiApp.Models.Veterinarian

@{
    ViewData["Title"] = "Veteriner Hekim Sil";
}

<h2 class="mb-3 text-danger">Veteriner Hekim Sil</h2>
<p>Bu veteriner hekimi silmek istediğinize emin misiniz?</p>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FullName)</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Specialty)</dt>
            <dd class="col-sm-9">@Model.Specialty</dd>

            <dt class="col-sm-3">Klinik</dt>
            <dd class="col-sm-9">@(Model.Clinic?.Name ?? "-")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>