@model IEnumerable<VeterinerKlinigiApp.Models.Veterinarian>

@{
    ViewData["Title"] = "Veteriner Hekimler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Veteriner Hekimler</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Hekim Ekle</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                <th>@Html.DisplayNameFor(model => model.Specialty)</th>
                <th>Klinik</th>
                <th>Verebildiği Hizmetler</th>
                <th style="width: 210px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Specialty</td>
                    <td>@(item.Clinic?.Name ?? "-")</td>
                    <td>
                        @if (item.VeterinarianServices != null && item.VeterinarianServices.Any())
                        {
                            @foreach (var vs in item.VeterinarianServices)
                            {
                                <span class="badge bg-info text-dark me-1">@vs.ClinicService?.Name</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Hizmet atanmamış</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detay</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
